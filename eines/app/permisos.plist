<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Permisos del «hardened runtime» que necessita Python empaquetat amb PyInstaller (obligatori per notaritzar). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Per trobar la pestanya de Cançoners que ja és oberta a Chrome (AppleScript) en lloc d'obrir-ne una altra. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
